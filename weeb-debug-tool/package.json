{
  "name": "@weeb/debug-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "kill-port 5000 5003",
    "dev": "pnpm run predev && cross-env BACKEND_PORT=5003 NODE_OPTIONS=--max-old-space-size=8192 concurrently -n \"vite,server\" -c \"cyan,magenta\" \"vite\" \"nodemon --exitcrash --watch server --ext ts,tsx,js,jsx,json --ignore server\\**\\generated\\** --ignore server\\**\\.cache\\** --exec tsx server/index.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "cross-env BACKEND_PORT=5003 NODE_OPTIONS=--max-old-space-size=8192 tsx server/index.ts"
  },
  "dependencies": {
    "@weeb/svg-generator": "workspace:*",
    "@weeb/weeb-plugins": "workspace:*",
    "cheerio": "^1.1.2",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vite": "^6.0.1"
  }
}
